 "head_html": "<section class=\"enc-cd-head\" aria-label=\"Race header\">\n  <div class=\"enc-cd-head__top\">\n    <a class=\"enc-cd-back\" href=\"card.html\"\n       aria-label=\"Back to card\">\n      <span aria-hidden=\"true\">&lsaquo;</span>\n      <span>Card</span>\n    </a>\n    <nav class=\"enc-cd-racenav\" aria-label=\"Race navigation\">\n      \n        <a class=\"enc-cd-racenav__chev\" href=\"race-1.html\"\n           data-role=\"race-prev\"\n           aria-label=\"Previous race\">&lsaquo;</a>\n      \n      <span class=\"enc-cd-racenav__label\">\n        Race 2<span class=\"enc-cd-racenav__of\">/9</span>\n      </span>\n      \n        <a class=\"enc-cd-racenav__chev\" href=\"race-3.html\"\n           data-role=\"race-next\"\n           aria-label=\"Next race\">&rsaquo;</a>\n      \n    </nav>\n  </div>\n\n  <h1 class=\"enc-cd-head__title\">Mj Church Handicap Stakes</h1>\n\n  <p class=\"enc-cd-head__meta\">\n    Bath &middot; \n    14:32\n     &middot; 1m5f11y\n     &middot; Good to Firm\n     &middot; Class 5\n  </p>\n\n  <div class=\"enc-cd-head__strip\">\n    \n      <span class=\"enc-cd-chip enc-cd-chip--settled\">Settled</span>\n    \n\n    \n      <span class=\"enc-cd-chip enc-cd-chip--prize\">\n        <span class=\"enc-cd-chip__label\">Prize</span>\n        <span class=\"enc-cd-chip__value\">£4,187</span>\n      </span>\n    \n\n    <span class=\"enc-cd-chip enc-cd-chip--field\">\n      <span class=\"enc-cd-chip__label\">Field</span>\n      <span class=\"enc-cd-chip__value\">14</span>\n    </span>\n  </div>\n</section>\n",
