 "head_html": "<section class=\"enc-cd-head\" aria-label=\"Race header\">\n  <div class=\"enc-cd-head__top\">\n    <a class=\"enc-cd-back\" href=\"card.html\"\n       aria-label=\"Back to card\">\n      <span aria-hidden=\"true\">&lsaquo;</span>\n      <span>Card</span>\n    </a>\n    <nav class=\"enc-cd-racenav\" aria-label=\"Race navigation\">\n      \n        <span class=\"enc-cd-racenav__chev enc-cd-racenav__chev--disabled\"\n              aria-hidden=\"true\">&lsaquo;</span>\n      \n      <span class=\"enc-cd-racenav__label\">\n        Race 1<span class=\"enc-cd-racenav__of\">/9</span>\n      </span>\n      \n        <a class=\"enc-cd-racenav__chev\" href=\"race-2.html\"\n           data-role=\"race-next\"\n           aria-label=\"Next race\">&rsaquo;</a>\n      \n    </nav>\n  </div>\n\n  <h1 class=\"enc-cd-head__title\">Jdl Consultants Ltd Apprentice Handicap Stakes</h1>\n\n  <p class=\"enc-cd-head__meta\">\n    Bath &middot; \n    14:02\n     &middot; 1m2f37y\n     &middot; Good to Firm\n     &middot; Class 5\n  </p>\n\n  <div class=\"enc-cd-head__strip\">\n    \n      <span class=\"enc-cd-chip enc-cd-chip--settled\">Settled</span>\n    \n\n    \n      <span class=\"enc-cd-chip enc-cd-chip--prize\">\n        <span class=\"enc-cd-chip__label\">Prize</span>\n        <span class=\"enc-cd-chip__value\">£4,187</span>\n      </span>\n    \n\n    <span class=\"enc-cd-chip enc-cd-chip--field\">\n      <span class=\"enc-cd-chip__label\">Field</span>\n      <span class=\"enc-cd-chip__value\">12</span>\n    </span>\n  </div>\n</section>\n<section class=\"enc-result\" aria-label=\"Result\">\n  <span class=\"enc-result__silk\"><img src=\"https://silks.theracingapi.com/silk?body=epaulettes:red,royalblue&amp;sleeves=armlet:royalblue,red&amp;cap=solid:white\" alt=\"\" width=\"52\" height=\"52\"></span>\n  <span class=\"enc-result__body\">\n    <span class=\"enc-result__label\">Winner</span>\n    <span class=\"enc-result__horse\">Oman</span>\n    <span class=\"enc-result__m