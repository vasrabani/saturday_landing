{
 "html": "\n\n  \n  <div class=\"enc-band enc-band--joined\">\n    <section class=\"enc-hero\" aria-labelledby=\"enc-hero-title\">\n      <p class=\"enc-hero__eyebrow\">Next race</p>\n      <p class=\"enc-hero__live\" hidden></p>\n      <h1 id=\"enc-hero-title\" class=\"enc-hero__title\">\n        16:35\n        \n          · Bath\n        \n        \n      </h1>\n      <div class=\"enc-hero__off\">\n        <div class=\"enc-hero__count\">15 min to off</div>\n        <div class=\"enc-hero__label\">\n          <span>Off at</span>\n          <strong>16:35</strong>\n        </div>\n      </div>\n    </section>\n  </div>\n  \n\n  <section class=\"enc-triptych\" aria-label=\"Race Day HQ\">\n    <div class=\"enc-tri\">\n      <div class=\"enc-tri__label\">Next</div>\n      \n        <div class=\"enc-tri__value enc-tri__value--dim\">TBC</div>\n        <div class=\"enc-tri__foot\">Pick landing</div>\n      \n    </div>\n\n    <div class=\"enc-tri\">\n      <div class=\"enc-tri__label\">Cup</div>\n      \n        <div class=\"enc-tri__value\">\n          3<span class=\"enc-tri__ord\">/11</span>\n        </div>\n        <div class=\"enc-tri__foot\">\n          1284 · 271 off\n        </div>\n      \n    </div>\n\n    <div class=\"enc-tri\">\n      <div class=\"enc-tri__label\">Recap</div>\n      \n        \n          \n            <div class=\"enc-tri__value enc-tri__value--lost\">Lost</div>\n            <div class=\"enc-tri__foot\">\n              South Shore\n            </div>\n          \n        \n      \n    </div>\n  </section>\n\n  \n\n  \n  <section class=\"enc-feed-rail\" aria-labelledby=\"enc-feed-rail-title\">\n    <header class=\"enc-sec\">\n      <h2 id=\"enc-feed-rail-title\" class=\"enc-sec__title\">The Feed</h2>\n      <a class=\"enc-sec__link\" href=\"feed.html\">See all</a>\n    </header>\n    <ol class=\"enc-feed-rail__list\">\n      \n        <li class=\"enc-feed-rail__item enc-feed-rail__item--guest_photo\">\n          <span class=\"enc-feed-rail__icon\"