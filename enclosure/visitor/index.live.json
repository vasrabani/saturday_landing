 "html": "\n\n  \n  <section class=\"enc-hero enc-hero--quiet\" aria-labelledby=\"enc-hero-title\">\n    <p class=\"enc-hero__eyebrow\">The day</p>\n    <h1 id=\"enc-hero-title\" class=\"enc-hero__title\">\n      Hartwell &amp; Penn at Bath\n    </h1>\n    <p class=\"enc-hero__quiet\">\n      Race day complete\n    </p>\n  </section>\n  \n\n  <section class=\"enc-triptych\" aria-label=\"Race Day HQ\">\n    <div class=\"enc-tri\">\n      <div class=\"enc-tri__label\">Next</div>\n      \n        <div class=\"enc-tri__value enc-tri__value--dim\">—</div>\n        <div class=\"enc-tri__foot\">All done</div>\n      \n    </div>\n\n    <div class=\"enc-tri\">\n      <div class=\"enc-tri__label\">Cup</div>\n      \n        <div class=\"enc-tri__value enc-tri__value--dim\">—</div>\n        <div class=\"enc-tri__foot\">No standings yet</div>\n      \n    </div>\n\n    <div class=\"enc-tri\">\n      <div class=\"enc-tri__label\">Recap</div>\n      \n        \n          <div class=\"enc-tri__value enc-tri__value--dim\">Skipped</div>\n          <div class=\"enc-tri__foot\">18:07</div>\n        \n      \n    </div>\n  </section>\n\n  \n\n  \n  <section class=\"enc-feed-rail\" aria-labelledby=\"enc-feed-rail-title\">\n    <header class=\"enc-sec\">\n      <h2 id=\"enc-feed-rail-title\" class=\"enc-sec__title\">The Feed</h2>\n      <a class=\"enc-sec__link\" href=\"feed.html\">See all</a>\n    </header>\n    <ol class=\"enc-feed-rail__list\">\n      \n        <li class=\"enc-feed-rail__item\">\n          <span class=\"enc-feed-rail__icon\" aria-hidden=\"true\">🏁</span>\n          <div class=\"enc-feed-rail__body\">\n            <div class=\"enc-feed-rail__meta\">\n              <span class=\"enc-feed-rail__title\">That is a wrap from Bath</span>\n              \n                <span class=\"enc-feed-rail__time\">25 min ago</span>\n              \n            </div>\n            \n              <p class=\"enc-feed-rail__text\">Thank you for joining Hartwell &amp; Penn at the races. The Race Book follows by email.</p>\n            \n          </div>\n        </li>\n      \n        <li class=\"enc-feed-rail__item\">\n          <span class=\"enc-feed-rail__icon\" aria-hidden=\"true\">🦙</span>\n          <div class=\"enc-feed-rail__body\">\n            <div class=\"enc-feed-rail__meta\">\n              <span class=\"enc-feed-rail__title\">Prize-giving at the bar</span>\n              \n                <span class=\"enc-feed-rail__time\">35 min ago</span>\n              \n            </div>\n            \n              <p class=\"enc-feed-rail__text\">The Corporate Champion and the Wooden Spoon will be presented at 18:45. Thank you all for …</p>\n            \n          </div>\n        </li>\n      \n        <li class=\"enc-feed-rail__item\">\n          <span class=\"enc-feed-rail__icon\" aria-hidden=\"true\">💬</span>\n          <div class=\"enc-feed-rail__body\">\n            <div class=\"enc-feed-rail__meta\">\n              <span class=\"enc-feed-rail__title\">Priya Shah</span>\n              \n                <span class=\"enc-feed-rail__time\">50 min ago</span>\n              \n            </div>\n            \n              <p class=\"enc-feed-rail__text\">Thank you Ruth and everyone. Best day out this year.</p>\n            \n          </div>\n        </li>\n      \n    </ol>\n  </section>\n  \n\n\n",
